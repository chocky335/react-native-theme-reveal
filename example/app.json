{
  "expo": {
    "name": "ThemeReveal Example",
    "slug": "react-native-theme-reveal-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "themereveal-example",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "expo.modules.themereveal.example",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "expo.modules.themereveal.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["./plugins/withProfileInstaller"]
  }
}
